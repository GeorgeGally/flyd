# Copy to /etc/flyd/mobile.env with owner root, mode 0600. Never commit real keys.
FLYD_MOBILE_ORIGIN=https://flyd.example.com
FLYD_MOBILE_PORT=4819
# Keep both off until explicit account/voice setup and cutover checks pass.
FLYD_MOBILE_ACCOUNTS=0
FLYD_MOBILE_VOICE=0
# Configure the same provider/model as existing Flyd; hosted models only here.
FLYD_CHAT_MODEL=openai:YOUR_MODEL
FLYD_MODEL=YOUR_MODEL
OPENAI_API_KEY=REPLACE_PRIVATELY
# Relative dates resolve using the service timezone; set to George's location.
TZ=Asia/Makassar
