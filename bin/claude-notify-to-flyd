#!/bin/sh
# Claude Code Notification hook: forwards the hook's JSON (stdin) to Flyd's
# conversation view, which shows it in the island or the column instead of a
# macOS notification. Never fails the hook: Flyd being down, or curl missing,
# still exits 0. FLYD_VIEW_URL overrides where Flyd listens.
curl --silent --max-time 2 --output /dev/null \
  --header 'content-type: application/json' \
  --data-binary @- \
  "${FLYD_VIEW_URL:-http://127.0.0.1:4818}/api/notice" >/dev/null 2>&1
exit 0
