[
  {
    "id": "date-today",
    "category": "grounding",
    "ask": "what's today's date?",
    "expect": {
      "answer": [
        "{{weekday}}",
        "{{day}}"
      ],
      "maxSeconds": 15
    }
  },
  {
    "id": "math-percent",
    "category": "reasoning",
    "ask": "what's 17% of 2340?",
    "expect": {
      "answer": [
        "397\\.8"
      ],
      "noTools": true,
      "maxSeconds": 15
    }
  },
  {
    "id": "math-tip-split",
    "category": "reasoning",
    "ask": "15% tip on 840,000 rupiah, split 3 ways \u2014 how much each?",
