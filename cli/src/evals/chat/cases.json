      "anyTool": [
        "web_search",
        "read_url"
      ],
      "answer": [
        "\u00b0|degrees"
      ],
      "maxSeconds": 90
    }
  },
  {
    "id": "reminders-list",
    "category": "personal",
    "ask": "what reminders do I have open?",
    "expect": {
      "anyTool": [
        "reminders"
      ],
      "maxSeconds": 30
    }
  },
  {
    "id": "reminder-create",
    "category": "personal",
    "ask": "remind me to water the plants tomorrow at 8am",
    "expect": {
      "toolInput": {
        "tool": "reminders",
        "match": {
          "action": "create",
          "due": "{{tomorrow}} 08:00"
        }
      },
      "maxToolCalls": 3,
      "maxSeconds": 30
    }
  },
  {
    "id": "remember-fact",
    "category": "personal",
    "ask": "remember that my passport expires in March 2027",
    "expect": {
      "anyTool": [
        "remember"
      ],
      "maxToolCalls": 3,
      "maxSeconds": 30
    }
  },
  {
    "id": "repo-latest-commit",
    "category": "code",
    "ask": "what's the latest commit in the flyd repo?",
    "expect": {
      "answer": [
        "{{flyd_head_subject}}"
      ],
      "maxSeconds": 45
    }
  },
  {
    "id": "code-where",
    "category": "code",
    "ask": "where in flyd is chat model failover implemented?",
    "expect": {
      "answer": [
