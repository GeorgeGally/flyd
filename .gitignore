# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

# Retired Rails tree (legacy/rails/). The root-level entries above stay so
# leftovers in older checkouts (logs, master.key, builds) remain ignored.
/legacy/rails/.bundle
/legacy/rails/log/*
!/legacy/rails/log/.keep
/legacy/rails/tmp/*
!/legacy/rails/tmp/.keep
!/legacy/rails/tmp/pids/
/legacy/rails/tmp/pids/*
!/legacy/rails/tmp/pids/.keep
/legacy/rails/storage/*
/legacy/rails/public/assets
/legacy/rails/config/master.key
/legacy/rails/app/assets/builds/*
!/legacy/rails/app/assets/builds/.keep

# Node / TS CLI
node_modules/
dist/
*.tgz
cli/node_modules/
cli/dist/

# OS
.DS_Store

# Redis
dump.rdb

# Agent artifacts
.commandcode/
.compound-engineering/
.superpowers/
flyd_v1/tmp/
